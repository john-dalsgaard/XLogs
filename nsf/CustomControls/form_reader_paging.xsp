<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core">
	<xp:panel tagName="span" styleClass="logPaging">
		<xp:text id="pageStatus" value="#{javascript:viewScope.currentFile.getPageStatus()}" />
		<xp:panel tagName="span" styleClass="logPagingLinks" rendered="#{javascript:viewScope.currentFile.isHasOlder() || viewScope.currentFile.isHasNewer()}">
			<xp:link id="olderLines" text="Older" rendered="#{javascript:viewScope.currentFile.isHasOlder()}">
				<xp:eventHandler event="onclick" submit="true" refreshMode="partial" refreshId="contentBody" immediate="true"><xp:this.action><![CDATA[#{javascript:viewScope.currentFile.older()}]]></xp:this.action></xp:eventHandler>
			</xp:link>
			<xp:link id="newerLines" text="Newer" rendered="#{javascript:viewScope.currentFile.isHasNewer()}">
				<xp:eventHandler event="onclick" submit="true" refreshMode="partial" refreshId="contentBody" immediate="true"><xp:this.action><![CDATA[#{javascript:viewScope.currentFile.newer()}]]></xp:this.action></xp:eventHandler>
			</xp:link>
			<xp:link id="latestLines" text="Latest">
				<xp:eventHandler event="onclick" submit="true" refreshMode="partial" refreshId="contentBody" immediate="true"><xp:this.action><![CDATA[#{javascript:viewScope.currentFile.latest()}]]></xp:this.action></xp:eventHandler>
			</xp:link>
		</xp:panel>
	</xp:panel>
</xp:view>
