<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core">
<xp:panel id="lotusColRight" styleClass="lotusColRight">
<!-- Section -->
				<div class="lotusSection">
					<h2>
						<span class="lotusLeft">Developer</span>
					</h2>
					<div class="lotusSectionBody">
						<div class="lotusChunk">
						<xp:link escape="true" value="http://www.majkilde.dk" target="_blank">
							<xp:image url="/majkilde.png" id="image1" style="height:auto;width:170px;margin-bottom:5.0px"></xp:image>
						</xp:link>
						<Strong>Jakob Majkilde</Strong>
						, Lotus Notes developer since 1992 and founder of&#160;
						<xp:link escape="true" text="notesnet.dk" value="http://www.notesnet.dk" target="_blank"></xp:link>.
						Freelance since 2000.
						</div>
					</div>
				</div><!--END section-->

				<!-- Project maintenance -->
				<div class="lotusSection">
					<h2>
						<span class="lotusLeft">Maintainer</span>
					</h2>
					<div class="lotusSectionBody">
						<div class="lotusChunk">
							<xp:link escape="true" value="https://www.dalsgaard-data.dk/" target="_blank">
								<xp:image url="/dalsgaard.jpg" id="maintainerImage" alt="John Dalsgaard" style="display:block;height:auto;width:170px;max-width:100%;margin-bottom:5px;" />
							</xp:link>
							<strong>John Dalsgaard</strong>, IT Specialist
							<p>Maintainer of XLogs since version 3.</p>
							<xp:link escape="true" text="Dalsgaard Data A/S" value="https://www.dalsgaard-data.dk/en-gb" target="_blank" />
						</div>
					</div>
				</div>




