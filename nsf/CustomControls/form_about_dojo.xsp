<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core">
<table class="lotusTable">
			<tr>
				<th style="width:200px;"><a id="dojo">Dojo</a></th>
				<th></th>
			</tr>
			<tr>
				<td>Default version</td>
				<td>
					<xp:text escape="true" value="#{javascript:com.ibm.xsp.context.DojoLibraryFactory.getDefaultLibrary().getVersion()}"></xp:text>

				</td>
			</tr>
			<tr>
				<td>Installed versions</td>
				<td>
					<xp:repeat id="repeat1" rows="30"
						var="dojoVersion"
					>
						<xp:this.value><![CDATA[#{javascript:
var libraries = com.ibm.xsp.context.DojoLibraryFactory.getDojoLibraries();
if (libraries instanceof java.util.Collection) libraries = libraries.toArray();
var versions = new java.util.LinkedHashSet();
for (var i = 0; i < libraries.length; i++) {
    versions.add(java.lang.String.valueOf(libraries[i].getVersion()));
}
return new java.util.ArrayList(versions);
}]]></xp:this.value>
						<xp:text escape="true" value="#{dojoVersion}"></xp:text>
						<br />
					</xp:repeat>
				</td>
			</tr>

		</table>

</xp:view>
