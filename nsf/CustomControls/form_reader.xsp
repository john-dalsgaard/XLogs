<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core" xmlns:xe="http://www.ibm.com/xsp/coreex" xmlns:xc="http://www.ibm.com/xsp/custom">
	<xp:this.beforePageLoad><![CDATA[#{javascript:layout.getCurrentFilelist();}]]></xp:this.beforePageLoad>
	<xp:this.beforeRenderResponse><![CDATA[#{javascript:
var current = viewScope.currentFile;
requestScope.xlogsContent = current == null ? "" : current.getHtml();
}]]></xp:this.beforeRenderResponse>
	<xp:panel loaded="${javascript:viewScope.currentFile!=null;}">
	<h1>
		<xp:text escape="true" id="computedField2" disableTheme="true">
			<xp:this.value><![CDATA[#{javascript:viewScope.currentFile.getFilename()}]]></xp:this.value>
		</xp:text>
	</h1>

	<div class="lotusSection">
		<h2>

			Current file:&#160;
			<xp:link escape="true" text="#{javascript:viewScope.currentFile.getFilename()}" id="download" styleClass="downloadLink">
				<xp:eventHandler event="onclick" submit="true" refreshMode="complete" immediate="true">
					<xp:this.action><![CDATA[#{javascript:viewScope.currentFile.download();}]]></xp:this.action>
					<xp:this.script><![CDATA[XSP.allowSubmit()]]></xp:this.script>
				</xp:eventHandler>
			</xp:link>
			, &#160;
			<xp:text escape="true" id="computedField6" value="#{javascript:dk.xpages.utils.NotesStrings.readableFileSize( viewScope.currentFile.getSize());}">
			</xp:text>
		</h2>
		
		<div class="lotusSectionBody">
			<xc:form_reader_fileinfo>
				<xc:this.rendered><![CDATA[#{javascript:viewScope.filelist.getCount()<=1}]]></xc:this.rendered>
			</xc:form_reader_fileinfo>
			<xc:form_reader_filebrowser>
				<xc:this.rendered><![CDATA[#{javascript:viewScope.filelist.getCount()>1}]]></xc:this.rendered>
			</xc:form_reader_filebrowser>
			<xc:form_reader_filters></xc:form_reader_filters>
		</div>
	</div>

	<div class="lotusSection">
		<h2>Content</h2>
		<xp:panel id="contentBody" styleClass="lotusSectionBody">
			<xp:panel styleClass="logPagingToolbar" rendered="#{javascript:viewScope.currentFile.getClass().getName()=='dk.majkilde.logreader.files.TextFile' &amp;&amp; viewScope.currentFile.isPaged()}">
				<xp:label for="pageSize" value="Lines per page:" />
				<xp:comboBox id="pageSize" value="#{viewScope.currentFile.pageSizeSelection}">
					<xp:selectItems value="#{viewScope.currentFile.pageSizeOptions}" />
					<xp:eventHandler event="onchange" submit="true" refreshMode="partial" refreshId="contentBody" onComplete="xlogsRestoreFilters();" />
				</xp:comboBox>
				<xc:form_reader_paging id="topPaging" />
			</xp:panel>
			<div class="fileViewer">
				<xp:text escape="false" id="fileContent" disableTheme="true" value="#{requestScope.xlogsContent}" />
			</div>
			<xp:panel rendered="#{javascript:viewScope.currentFile.getClass().getName()=='dk.majkilde.logreader.files.TextFile' &amp;&amp; viewScope.currentFile.isPaged() &amp;&amp; viewScope.currentFile.isShowBottomPaging()}">
				<xc:form_reader_paging id="bottomPaging" />
			</xp:panel>
		</xp:panel>
	</div>
	</xp:panel>
</xp:view>