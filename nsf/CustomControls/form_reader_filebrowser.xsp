<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core">

	<xp:this.beforeRenderResponse><![CDATA[#{javascript:
if (viewScope.resetFileListPaging == true) {
	getComponent("files").setFirst(0);
	viewScope.remove("resetFileListPaging");
}
}]]></xp:this.beforeRenderResponse>

	<xp:this.resources>
		<xp:dojoModule name="dijit.Tooltip"></xp:dojoModule>
	</xp:this.resources>

	<xp:panel tagName="div" styleClass="fileSelectorSummary">
		<xp:this.attrs>
			<xp:attr name="title" value="#{javascript:viewScope.filelist.getPattern()}" />
		</xp:this.attrs>
		<xp:text escape="true" value="#{javascript:viewScope.filelist.getCount()}">
			<xp:this.converter>
				<xp:convertNumber type="number" integerOnly="true" />
			</xp:this.converter>
		</xp:text>
		&#160;files
	</xp:panel>

	<xp:button id="syncZipSelection" value="Update selection" style="display:none;">
		<xp:eventHandler event="onclick" submit="true" refreshMode="complete" immediate="true">
			<xp:this.action><![CDATA[#{javascript:viewScope.filelist.updateSelection();}]]></xp:this.action>
		</xp:eventHandler>
	</xp:button>
	<div class="fileSelector">
		<xp:pager partialRefresh="false" id="filesPager" for="files" layout="Previous Next"></xp:pager>
		<ul>
			<xp:repeat id="files" rows="5" var="file" removeRepeat="true">
				<xp:this.value><![CDATA[#{javascript:viewScope.filelist.getFiles();}]]></xp:this.value>
				<li style="display:flex;align-items:center;">
					<xp:text escape="false" disableTheme="true" rendered="#{viewScope.filelist.zipSupported}"
						value="#{javascript:viewScope.filelist.getSelectionHtml(file, getClientId('syncZipSelection'))}" />
					<xp:link escape="true" id="tip" style="display:block;flex:1;min-width:0;">
						<xp:this.styleClass><![CDATA[#{javascript:if( viewScope.currentFile==file) {"current"}}]]></xp:this.styleClass>
						<xp:text escape="true" id="computedField3" styleClass="fileSelectorDate" value="#{javascript:dk.xpages.utils.XSPUtils.formatServerDate(file.getDate());}">
						</xp:text>
						<xp:text escape="true" styleClass="fileSelectorName" value="#{javascript:file.getFilename()}" />
						<xp:eventHandler event="onclick" submit="true" refreshMode="complete" immediate="true">
							<xp:this.action><![CDATA[#{javascript:viewScope.filelist.setCurrent( file );}]]></xp:this.action>
						</xp:eventHandler>
						<xp:eventHandler event="onmouseleave" submit="false">
							<xp:this.script><![CDATA[var popup = dijit.byId('#{id:fileTooltip}');
if (popup) popup.close();]]></xp:this.script>
						</xp:eventHandler>
						<xp:eventHandler event="onblur" submit="false">
							<xp:this.script><![CDATA[var popup = dijit.byId('#{id:fileTooltip}');
if (popup) popup.close();]]></xp:this.script>
						</xp:eventHandler>
					</xp:link>

					<xp:panel id="fileTooltip" tagName="div" style="display:none;">
						<xp:this.attrs>
							<xp:attr name="dojoType" value="dijit.Tooltip" />
							<xp:attr name="connectId" value="#{id:tip}" />
							<xp:attr name="position" value="below" />
							<xp:attr name="showDelay" value="0" />
							<xp:attr name="hideDelay" value="0" />
						</xp:this.attrs>
						<table class="tip">
							<tr>
								<th>Filename:</th>
								<td>
									<xp:text escape="true" id="computedField7" value="#{javascript:file.getFilename();}"></xp:text>
								</td>
							</tr>
							<tr>
								<th>Path:</th>
								<td><xp:text escape="true" value="#{javascript:file.getPath()}" /></td>
							</tr>
							<tr>
								<th>Size: </th>
								<td>
									<xp:text escape="true" id="computedField1" value="#{javascript:dk.xpages.utils.NotesStrings.readableFileSize( file.getSize());}"></xp:text>
								</td>
							</tr>
						</table>
					</xp:panel>
				</li>
			</xp:repeat>
		</ul>
	</div>


</xp:view>
